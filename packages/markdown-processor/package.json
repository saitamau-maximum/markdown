{
  "name": "@saitamau-maximum/markdown-processor",
  "version": "2.2.4",
  "private": false,
  "type": "module",
  "scripts": {
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsdown",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "sor4chi",
  "license": "MIT",
  "dependencies": {
    "@shikijs/rehype": "^4.0.2",
    "@shikijs/transformers": "^4.0.2",
    "hast-util-heading-rank": "^3.0.0",
    "hast-util-to-string": "^3.0.1",
    "hastscript": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-flexible-code-titles": "^1.3.3",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "glob": "^13.0.6",
    "hast": "^1.0.0",
    "hast-util-sanitize": "^5.0.2",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "remark": "^15.0.1",
    "tsdown": "^0.21.10",
    "vfile": "^6.0.3"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./processor": {
      "types": "./dist/processor/index.d.mts",
      "import": "./dist/processor/index.mjs"
    },
    "./processor/full": {
      "types": "./dist/processor/full.d.mts",
      "import": "./dist/processor/full.mjs"
    },
    "./processor/web": {
      "types": "./dist/processor/web.d.mts",
      "import": "./dist/processor/web.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "processor": [
        "./dist/processor/index.d.mts"
      ],
      "processor/full": [
        "./dist/processor/full.d.mts"
      ],
      "processor/web": [
        "./dist/processor/web.d.mts"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/saitamau-maximum/markdown.git",
    "directory": "packages/markdown-processor"
  }
}
