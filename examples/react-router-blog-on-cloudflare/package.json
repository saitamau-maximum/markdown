{
  "name": "react-router-blog-on-cloudflare",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "typegen": "wrangler types && react-router typegen",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "react-router dev",
    "postinstall": "pnpm run typegen",
    "preview": "pnpm run build && vite preview",
    "typecheck": "pnpm run typegen && tsc -b",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@saitamau-maximum/markdown-processor": "workspace:*",
    "isbot": "^5.1.39",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.34.0",
    "@react-router/dev": "^7.14.2",
    "@shikijs/transformers": "^4.0.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "wrangler": "^4.86.0"
  }
}
